{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loot-of-legends.invalid/contracts/meta-api/game-credential-v1.schema.json",
  "title": "Loot of Legends V2 Game Credential HTTP Contract",
  "status": "Accepted",
  "version": "1.0.0",
  "credentialPolicy": {
    "entropyBytes": 32,
    "encoding": "base64url-without-padding",
    "ttlSeconds": 30,
    "outcomeRetentionSeconds": 30,
    "audience": "loot-game-server-v1",
    "singleUse": true,
    "lookupHash": "SHA-256",
    "storesRawCredential": false
  },
  "endpoints": {
    "issue": {
      "method": "POST",
      "path": "/api/v1/game-credentials",
      "authentication": "META_PRINCIPAL",
      "requestBody": null,
      "responses": {
        "201": { "schemaRef": "#/$defs/issuedGameCredential" },
        "401": { "schemaRef": "#/$defs/error" },
        "503": { "schemaRef": "#/$defs/error" }
      }
    },
    "claim": {
      "method": "POST",
      "path": "/internal/v1/game-credentials/claim",
      "authentication": "SERVICE_BEARER",
      "authenticationHeader": "Authorization: Bearer <service-credential>",
      "requestSchemaRef": "#/$defs/claimGameCredential",
      "responses": {
        "200": { "schemaRef": "#/$defs/claimedGameIdentity" },
        "400": { "code": "INVALID", "schemaRef": "#/$defs/error" },
        "401": { "code": "UNAUTHORIZED", "schemaRef": "#/$defs/error" },
        "409": { "code": "ALREADY_CONSUMED", "schemaRef": "#/$defs/error" },
        "410": { "code": "EXPIRED", "schemaRef": "#/$defs/error" },
        "422": { "code": "WRONG_AUDIENCE", "schemaRef": "#/$defs/error" },
        "503": { "code": "DEPENDENCY_UNAVAILABLE", "schemaRef": "#/$defs/error" }
      }
    }
  },
  "$defs": {
    "credential": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "issuedGameCredential": {
      "type": "object",
      "required": ["credential", "expiresAt"],
      "properties": {
        "credential": { "$ref": "#/$defs/credential" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "claimGameCredential": {
      "type": "object",
      "required": ["credential", "audience"],
      "properties": {
        "credential": { "$ref": "#/$defs/credential" },
        "audience": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "claimedGameIdentity": {
      "type": "object",
      "required": ["accountId", "nickname"],
      "properties": {
        "accountId": { "type": "string", "format": "uuid" },
        "nickname": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID",
            "UNAUTHORIZED",
            "ALREADY_CONSUMED",
            "EXPIRED",
            "WRONG_AUDIENCE",
            "DEPENDENCY_UNAVAILABLE"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
